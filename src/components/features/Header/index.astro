---
import { Image } from "astro:assets";
import { withBase } from "../../../utils/url";
import tsKaigiImage from "../../../assets/TSKaigi.png";
---

<header>
  <Image src={tsKaigiImage} alt={"TSKaigiロゴ画像"} height={31} />
  <ul>
    <li>
      <a href={withBase("/side-event/")}>サイドイベント</a>
    </li>
    <li>
      <a href={withBase("/code-of-conduct/")}>行動規範</a>
    </li>
  </ul>
</header>
<style>
  header {
    background-color: var(--color-header-background);
    color: var(--color-text);
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    margin-left: 1rem;
  }
</style>
